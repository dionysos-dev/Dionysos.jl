#!/usr/bin/env bash
# Regenerates all the results. On CodeOcean (set up by environment/postInstall) they go to
# /results; locally, run from this folder inside the Dionysos.jl repository, to ./results.
set -euo pipefail
cd "$(dirname "$0")"
if [ -d /opt/Dionysos.jl ]; then
    export JULIA_DEPOT_PATH=/opt/julia_depot
    export RESULTS_DIR=/results
    export GKSwstype=100 # plots without a display
    julia --project=/opt/Dionysos.jl/research/ECC2027 --threads="${CO_CPUS:-auto}" run_all.jl
else
    julia --project=. -e 'import Pkg; Pkg.instantiate()'
    julia --project=. --threads=auto run_all.jl
fi
