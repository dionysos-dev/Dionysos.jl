#!/usr/bin/env bash
# CodeOcean build step, run once with network access: Julia, Dionysos.jl at a fixed commit, and
# the packages of the manifest, precompiled. The runs then need no network.
set -euo pipefail

JULIA_VERSION=1.12.5
DIONYSOS_COMMIT=c2a2ffe2920a6dded2b2b44de93a917c288ae638
export JULIA_DEPOT_PATH=/opt/julia_depot

apt-get update
apt-get install -y --no-install-recommends ca-certificates curl git

curl -fsSL "https://julialang-s3.julialang.org/bin/linux/x64/${JULIA_VERSION%.*}/julia-${JULIA_VERSION}-linux-x86_64.tar.gz" |
    tar -xz -C /opt
ln -sf "/opt/julia-${JULIA_VERSION}/bin/julia" /usr/local/bin/julia

# The manifest points to Dionysos two folders up, which is the clone itself.
git clone https://github.com/dionysos-dev/Dionysos.jl /opt/Dionysos.jl
git -C /opt/Dionysos.jl checkout --detach "$DIONYSOS_COMMIT"
julia --project=/opt/Dionysos.jl/research/ECC2027 -e 'import Pkg; Pkg.instantiate(); Pkg.precompile()'
